{
  "name": "job-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "db:build-import": "python scripts/build_d1_import.py --input ../../docs/data/public_jobs.json --output-dir generated",
    "db:load:local": "wrangler d1 execute irish-job-board-prod --local --file=generated/load.sql",
    "db:activate:local": "wrangler d1 execute irish-job-board-prod --local --file=generated/activate.sql",
    "db:load:remote": "wrangler d1 execute irish-job-board-prod --remote --file=generated/load.sql",
    "db:activate:remote": "wrangler d1 execute irish-job-board-prod --remote --file=generated/activate.sql",
    "db:migrate:local": "wrangler d1 migrations apply irish-job-board-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply irish-job-board-prod --remote",
    "db:migrations:list": "wrangler d1 migrations list irish-job-board-prod --local",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.124.0"
  }
}
