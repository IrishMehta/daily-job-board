# Ignore everything in this folder by default.
*

# Keep this file.
!.gitignore

# Keep the publishable artifacts only.
!README.md
!docs/
!docs/**
!build_public_job_board_listings.py
!tests/
!tests/test_public_board_listings.py
!tests/test_frontend_contract.py
!tests/test_taxonomy_navigation.py

# Track the Spark market-analysis implementation, but never its local warehouse,
# checkpoints, or staged source tails.
market_analysis/
# !market_analysis/*.py
# !market_analysis/*.md
# !market_analysis/*.txt
# !market_analysis/ontology_sources.json
# !market_analysis/skill_ontology_overrides.json
# !market_analysis/tests/
# !market_analysis/tests/**
# market_analysis/data/
# market_analysis/state/
# market_analysis/staging/

# Keep the public job API source and its deployment workflow.
!services/
!services/job-api/
!services/job-api/**
!.github/
!.github/workflows/
!.github/workflows/deploy-job-api.yml

!.github/workflows/sync-job-api-data.yml
